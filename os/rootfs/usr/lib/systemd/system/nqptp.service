# Based on nqptp 1.2.8's nqptp.service.in (https://github.com/mikebrady/nqptp), prefix filled in.
[Unit]
Description=NQPTP -- Not Quite PTP (AirPlay 2 timing for shairport-sync)
Wants=network-online.target
After=network.target network-online.target

[Service]
ExecStart=/usr/bin/nqptp
DynamicUser=yes
LimitRTPRIO=6
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
