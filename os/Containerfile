# hue-jack appliance OS: a Fedora bootc image.
#
#   podman build -f os/Containerfile -t localhost/hue-jack:dev .
#
# Stages: "airplay" builds nqptp + shairport-sync (AirPlay 2) from source, "js" builds the web UI
# and the ytcr sidecar with pnpm, "app" builds hue-jack (web UI embedded), and the final stage is
# the bootable image.

# ---------------------------------------------------------------------------------------------
# AirPlay 2: Fedora's shairport-sync package is built without AirPlay 2 or MPRIS, and nqptp isn't
# packaged, so build both from source.
FROM quay.io/fedora/fedora:44 AS airplay

ARG NQPTP_VERSION=1.2.8
ARG SHAIRPORT_SYNC_VERSION=5.5.2

RUN dnf install -y --setopt=install_weak_deps=False \
        gcc gcc-c++ make autoconf automake libtool pkgconf-pkg-config git-core xxd \
        avahi-devel libconfig-devel openssl-devel popt-devel soxr-devel \
        ffmpeg-free-devel libplist-devel libsodium-devel libgcrypt-devel libuuid-devel \
        pipewire-devel pulseaudio-libs-devel glib2-devel \
    && dnf clean all

RUN git clone --depth 1 --branch "${NQPTP_VERSION}" https://github.com/mikebrady/nqptp.git /src/nqptp \
    && cd /src/nqptp \
    && autoreconf -fi \
    && ./configure --prefix=/usr \
    && make -j"$(nproc)" \
    && install -D -m 0755 nqptp /out/usr/bin/nqptp

RUN git clone --depth 1 --branch "${SHAIRPORT_SYNC_VERSION}" https://github.com/mikebrady/shairport-sync.git /src/shairport-sync \
    && cd /src/shairport-sync \
    && autoreconf -fi \
    && ./configure --prefix=/usr --sysconfdir=/etc \
        --with-airplay-2 --with-pipewire --with-pulseaudio \
        --with-mpris-interface --with-metadata \
        --with-avahi --with-ssl=openssl --with-soxr \
    && make -j"$(nproc)" \
    && install -D -m 0755 shairport-sync /out/usr/bin/shairport-sync \
    && /out/usr/bin/shairport-sync -V \
    && /out/usr/bin/shairport-sync -V | grep -q AirPlay2

# ---------------------------------------------------------------------------------------------
# Web UI and ytcr sidecar (pnpm workspace). Upstream Node rather than Fedora's: `pnpm deploy`
# segfaults on Fedora 44's nodejs24 (24.18). The output is plain JS, so it runs on the image's
# Fedora Node.
FROM docker.io/library/node:24-slim AS js

WORKDIR /src

# pnpm, at the exact version (and sha512) pinned by `packageManager` in package.json.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
RUN COREPACK_ENABLE_DOWNLOAD_PROMPT=0 corepack enable pnpm && pnpm --version

# Fetch dependencies first (by lockfile only), so they're cached while the sources change.
RUN pnpm fetch --frozen-lockfile

COPY web/ web/
COPY ytcr/ ytcr/
RUN pnpm install --frozen-lockfile --offline \
    && pnpm -r run build \
    && pnpm --filter hue-jack-ytcr deploy --prod --offline /out/ytcr

# ---------------------------------------------------------------------------------------------
# hue-jack (Rust, web UI embedded).
FROM quay.io/fedora/fedora:44 AS app

RUN dnf install -y --setopt=install_weak_deps=False \
        rust cargo gcc pkgconf-pkg-config clang-devel \
        pipewire-devel openssl-devel dbus-devel git-core \
    && dnf clean all

WORKDIR /src

COPY . .
COPY --from=js /src/web/dist web/dist

RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    --mount=type=cache,target=/src/target \
    cargo build --release --locked -p hue-jack \
    && install -D -m 0755 target/release/hue-jack /out/usr/bin/hue-jack

# ---------------------------------------------------------------------------------------------
FROM quay.io/fedora/fedora-bootc:44

LABEL org.opencontainers.image.source=https://github.com/axle-h/hue-jack
LABEL org.opencontainers.image.description="hue-jack: Bluetooth / AirPlay 2 / YouTube Music cast receiver that drives Philips Hue lights in sync"
LABEL org.opencontainers.image.licenses=MIT

# Audio stack, receivers and their runtime libraries. iwlbluetooth-firmware is needed by the
# NUC's Intel 8260 Bluetooth (btintel ibt-* firmware). No firewalld: AirPlay 2, DIAL/SSDP and
# mDNS need wide port ranges on the home LAN.
RUN dnf install -y \
        pipewire wireplumber pipewire-pulseaudio pipewire-alsa pipewire-utils \
        bluez iwlbluetooth-firmware avahi nss-mdns \
        mpv nodejs24 nodejs24-bin alsa-utils \
        libconfig popt soxr libplist libsodium libgcrypt libuuid \
        libavcodec-free libavformat-free libavutil-free libswresample-free \
        avahi-libs glib2 pulseaudio-libs \
    && dnf clean all \
    && rm -rf /var/cache/* /var/log/* /var/lib/dnf /run/dnf

COPY --from=airplay /out/usr/bin/ /usr/bin/
COPY --from=app /out/usr/bin/hue-jack /usr/bin/hue-jack
COPY --from=js /out/ytcr/ /usr/lib/hue-jack/ytcr/
COPY os/rootfs/ /

# - huejack needs the "audio" group for ALSA. On bootc that group is in /usr/lib/group
#   (nss-altfiles, merged with /etc/group), where sysusers can't add members, so add it here.
# - Fail the build if a binary built in another stage is missing a runtime library.
# - Global user units start for every user; each one has ConditionUser=huejack.
RUN set -eux; \
    chmod 0440 /etc/sudoers.d/wheel-nopasswd; \
    sed -i -E 's/^(audio:x:[0-9]+:)$/\1huejack/;t;s/^(audio:x:[0-9]+:.+)$/\1,huejack/' /usr/lib/group; \
    grep -E '^audio:x:[0-9]+:(.*,)?huejack$' /usr/lib/group; \
    for bin in /usr/bin/hue-jack /usr/bin/shairport-sync /usr/bin/nqptp; do \
        if ldd "$bin" | grep 'not found'; then echo "missing libraries for $bin" >&2; exit 1; fi; \
    done; \
    shairport-sync -V | grep -q AirPlay2; \
    systemctl enable bluetooth.service avahi-daemon.service nqptp.service; \
    systemctl mask bootc-fetch-apply-updates.timer; \
    systemctl --global enable hue-jack.service hue-jack-ytcr.service hue-jack-shairport.service mpris-proxy.service

RUN bootc container lint
